<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DriverForge.Converters">

    <!-- Palette from the approved mockup (dark, Windows 11). -->
    <Color x:Key="AccentColor">#4CC2FF</Color>
    <SolidColorBrush x:Key="Accent" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentHover" Color="#7FD3FF" />
    <SolidColorBrush x:Key="OnAccent" Color="#002A3D" />
    <SolidColorBrush x:Key="Page" Color="#272727" />
    <SolidColorBrush x:Key="Card" Color="#2C2C2C" />
    <SolidColorBrush x:Key="CardRaised" Color="#2F2F2F" />
    <SolidColorBrush x:Key="Inset" Color="#252525" />
    <SolidColorBrush x:Key="Line" Color="#363636" />
    <SolidColorBrush x:Key="LineStrong" Color="#3D3D3D" />
    <SolidColorBrush x:Key="Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B5B5B5" />
    <SolidColorBrush x:Key="TextTertiary" Color="#A8A8A8" />
    <SolidColorBrush x:Key="SelectedRow" Color="#2C3438" />
    <SolidColorBrush x:Key="SelectedCand" Color="#26333A" />

    <SolidColorBrush x:Key="MissingBg" Color="#4A2B2F" />
    <SolidColorBrush x:Key="MissingFg" Color="#FFB3BB" />
    <SolidColorBrush x:Key="UpdateBg" Color="#173A4D" />
    <SolidColorBrush x:Key="UpdateFg" Color="#8FDCFF" />
    <SolidColorBrush x:Key="SkipBg" Color="#383838" />
    <SolidColorBrush x:Key="SkipFg" Color="#C8C8C8" />
    <SolidColorBrush x:Key="OkBg" Color="#233D22" />
    <SolidColorBrush x:Key="OkFg" Color="#6CCB5F" />
    <SolidColorBrush x:Key="WarnBg" Color="#2F2A1A" />
    <SolidColorBrush x:Key="WarnLine" Color="#5C4E1A" />
    <SolidColorBrush x:Key="WarnFg" Color="#F3E2A0" />

    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibility x:Key="InvBoolToVis" />
    <conv:InverseBool x:Key="InvBool" />
    <conv:ZeroToVisibility x:Key="ZeroToVis" />
    <conv:NullToVisibility x:Key="NullToVis" />
    <conv:NullToVisibility x:Key="NotNullToVis" Invert="True" />
    <conv:StateBrush x:Key="StateBg" Part="Background" />
    <conv:StateBrush x:Key="StateFg" Part="Foreground" />

    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="MonoSmall" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#C8C8C8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Flat buttons matching the mockup; ui:Button keeps WPF-UI's look elsewhere. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource CardRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#383838" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="#3A4A52" />
                            <Setter Property="Foreground" Value="#9AB0BB" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chip: a pill that shows whether it's the active filter. -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{StaticResource CardRaised}" BorderBrush="{StaticResource LineStrong}"
                            BorderThickness="1" CornerRadius="16" Padding="14,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource UpdateBg}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="#BFEAFF" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#333333" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
</ResourceDictionary>
