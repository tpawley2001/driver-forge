<ui:FluentWindow x:Class="DriverForge.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:DriverForge.ViewModels"
                 xmlns:views="clr-namespace:DriverForge.Views"
                 Title="Driver Forge"
                 Icon="/DriverForge;component/Assets/app.ico"
                 Width="1320" Height="880" MinWidth="980" MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Background="#1C1C1C">
    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}"><views:DriversView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallViewModel}"><views:InstallView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SourcesViewModel}"><views:SourcesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}"><views:CleanupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComingSoonViewModel}"><views:ComingSoonView /></DataTemplate>

        <DataTemplate x:Key="NavButton" DataType="{x:Type vm:NavItem}">
            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                    CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,4"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{Binding Label}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" MinHeight="40" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="icon" Symbol="{Binding Icon}" FontSize="18" Foreground="#E6E6E6" VerticalAlignment="Center" />
                                <TextBlock x:Name="label" Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0" Foreground="#E6E6E6"
                                           VerticalAlignment="Center" FontSize="14" />
                                <Border Grid.Column="2" Background="{StaticResource Accent}" CornerRadius="10" Padding="8,1"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Badge}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Badge}" Foreground="{StaticResource OnAccent}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2B2B2B" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2D2D2D" />
                                <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter TargetName="label" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="label" Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The sidebar already names the app; the title bar only carries the window buttons. -->
        <ui:TitleBar Title="" Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="12,4,12,16" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,6,0,18">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Accent}">
                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="18" Foreground="{StaticResource OnAccent}" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Driver Forge" FontWeight="SemiBold" FontSize="15" Foreground="White" />
                        <TextBlock Text="{Binding EngineLabel}" FontSize="12" Foreground="{StaticResource TextTertiary}" />
                    </StackPanel>
                </StackPanel>
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Nav}" ItemTemplate="{StaticResource NavButton}" />
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding SettingsNav}" ContentTemplate="{StaticResource NavButton}" />
            </DockPanel>

            <Border Grid.Column="1" Background="{StaticResource Page}" BorderBrush="#333333" BorderThickness="1,1,0,0"
                    CornerRadius="10,0,0,0">
                <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
