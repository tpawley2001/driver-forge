<UserControl x:Class="DriverForge.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="900" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Scan now" Command="{Binding RescanCommand}" VerticalAlignment="Center" />
                <TextBlock Text="Driver sources" FontSize="28" FontWeight="SemiBold" Foreground="White" />
            </DockPanel>
            <TextBlock Text="Windows checks every driver against your devices before it's offered, wherever it comes from."
                       Style="{StaticResource Secondary}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16" />

            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Windows Update" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Always on. Includes the optional driver updates Windows doesn't install by itself."
                               Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="This PC" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Always on. Drivers already in Windows' driver store." Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                <DockPanel>
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding UseCatalog}" VerticalAlignment="Center"
                                     AutomationProperties.Name="Search the Microsoft Update Catalog" />
                    <StackPanel>
                        <TextBlock Text="Microsoft Update Catalog" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Drivers Windows Update doesn't offer this PC. The first scan takes a few minutes; results are kept for a day. Drivers from other makers than a device's current one are listed but not recommended."
                                   Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Add folder…" Command="{Binding AddFolderCommand}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Driver folders" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Folders of drivers, such as a PC maker's driver download. .zip and .cab files inside are unpacked."
                                       Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="No folders added." Style="{StaticResource Secondary}" Margin="0,10,0,0">
                        <TextBlock.Visibility>
                            <Binding Path="Folders.Count" Converter="{StaticResource ZeroToVis}" />
                        </TextBlock.Visibility>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Folders}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Remove"
                                            Command="{Binding DataContext.RemoveFolderCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource MonoSmall}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
