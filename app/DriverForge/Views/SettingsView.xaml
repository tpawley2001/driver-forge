<UserControl x:Class="DriverForge.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,20" />

            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                <DockPanel>
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding CreateRestorePoint}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Create a restore point before installing" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Windows can roll the whole system back to it if a driver misbehaves." Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                <DockPanel>
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding RestartWhenNeeded}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Restart automatically when a driver needs it" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Gives a 60-second warning first, which you can cancel." Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                <DockPanel>
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding TestMode}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Test mode" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Installs run end to end (download, extract) but skip the driver install itself. Nothing on this PC changes."
                                   Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Ignored devices" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="These are never offered updates." Style="{StaticResource Secondary}" Margin="0,0,0,10" />
                    <TextBlock Text="None.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Ignored.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Ignored}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Stop ignoring"
                                            Command="{Binding DataContext.UnignoreCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource MonoSmall}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

 <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="140" ItemsSource="{Binding Schedules}" SelectedItem="{Binding ScanSchedule}"
                                  VerticalAlignment="Center" AutomationProperties.Name="Scan automatically" />
                        <StackPanel>
                            <TextBlock Text="Scan automatically" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="At noon (weekly: Sundays) while you're signed in. A notification appears only when a driver is missing or an update is available; nothing is installed without you."
                                       Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding ScheduleError}" Foreground="{StaticResource MissingFg}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding ScheduleError, Converter={StaticResource NullToVis}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Text="Data folder" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource MonoSmall}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Settings, driver backups, history and download caches live here. Driver Forge © Hillyard Tech, MIT License." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
