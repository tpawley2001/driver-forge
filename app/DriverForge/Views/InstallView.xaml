<UserControl x:Class="DriverForge.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DriverForge.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel after this driver" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Back to drivers" Command="{Binding BackToDriversCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource InvBoolToVis}}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{Binding StepText}" Style="{StaticResource Secondary}" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <ProgressBar Value="{Binding Percent}" Maximum="100" Height="6" Margin="0,0,0,8"
                         IsIndeterminate="{Binding IsRunning}" />
            <TextBlock Text="{Binding ResultText}" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,14"
                       Visibility="{Binding ResultText, Converter={StaticResource NullToVis}}" TextWrapping="Wrap" />

            <Border CornerRadius="8" Padding="14,12" Margin="0,0,0,8" BorderThickness="1"
                    Visibility="{Binding RestorePointText, Converter={StaticResource NullToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource WarnBg}" />
                        <Setter Property="BorderBrush" Value="{StaticResource WarnLine}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RestorePointOk}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Card}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="18" Margin="0,0,12,0">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Warning24" />
                                <Setter Property="Foreground" Value="{StaticResource WarnFg}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RestorePointOk}" Value="True">
                                        <Setter Property="Symbol" Value="ShieldCheckmark24" />
                                        <Setter Property="Foreground" Value="{StaticResource OkFg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Text="{Binding RestorePointText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:InstallItemViewModel}">
                        <Border CornerRadius="8" Padding="14,12" Margin="0,0,0,8" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Card}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SelectedCand}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Grid Width="28" Height="28" Margin="0,0,14,0">
                                    <Border CornerRadius="14" Background="{StaticResource OkBg}" Visibility="{Binding IsOk, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="Checkmark16" FontSize="14" Foreground="{StaticResource OkFg}" />
                                    </Border>
                                    <Border CornerRadius="14" Background="{StaticResource MissingBg}" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{StaticResource MissingFg}" />
                                    </Border>
                                    <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                    <Ellipse Stroke="#4A4A4A" StrokeThickness="2" Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0">
                                        <Run Text="{Binding Detail, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Target, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnLine}" BorderThickness="1" CornerRadius="8"
                    Padding="14,12" Margin="0,8,0,8" Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="Restart in 60 s" Command="{Binding ScheduleRestartCommand}"
                                Visibility="{Binding RestartScheduled, Converter={StaticResource InvBoolToVis}}" />
                        <Button Style="{StaticResource GhostButton}" Content="Cancel restart" Command="{Binding CancelRestartCommand}"
                                Visibility="{Binding RestartScheduled, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource WarnFg}" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="A restart is needed to finish installing. Nothing restarts without asking unless you turned that on." />
                </DockPanel>
            </Border>

            <Expander Header="Log" Margin="0,8,0,0" IsExpanded="False">
                <ItemsControl ItemsSource="{Binding Log}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="#C8C8C8" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
