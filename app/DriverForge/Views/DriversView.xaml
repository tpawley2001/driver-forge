<UserControl x:Class="DriverForge.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DriverForge.ViewModels"
             x:Name="Root">
    <UserControl.Resources>
        <DataTemplate x:Key="DeviceRow" DataType="{x:Type vm:DeviceRowViewModel}">
            <Border Margin="0,0,0,6" Padding="14,12" CornerRadius="8" BorderThickness="1" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Card}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E2E" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectedRow}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.SelectCommand, ElementName=Root}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanInstall}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,10,0" Padding="0"
                              AutomationProperties.Name="{Binding Name, StringFormat='Install a driver for {0}'}" />
                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="#353535" Margin="2,0,14,0">
                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Foreground="#DCDCDC" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding HardwareId}" Style="{StaticResource MonoSmall}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock FontSize="13" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding CurrentVersion, Mode=OneWay}" Foreground="{StaticResource TextTertiary}" />
                            <Run Text="  →  " Foreground="#D6D6D6" />
                            <Run Text="{Binding NextVersion, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="{Binding Dates}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="4" Style="{StaticResource Badge}" Background="{Binding State, Converter={StaticResource StateBg}}">
                        <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding State, Converter={StaticResource StateFg}}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CandidateRow" DataType="{x:Type vm:CandidateViewModel}">
            <RadioButton IsChecked="{Binding IsChosen}" Margin="0,0,0,8" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                         AutomationProperties.Name="{Binding Version}">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8" BorderThickness="1" Padding="12,10"
                                Background="#272727" BorderBrush="#3A3A3A">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dot" Width="16" Height="16" Stroke="#8A8A8A" StrokeThickness="1.5" Margin="0,2,12,0" VerticalAlignment="Top" />
                                <Ellipse x:Name="pip" Width="8" Height="8" Fill="{StaticResource Accent}" Margin="4,6,0,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock>
                                        <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" Foreground="White" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Date, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextTertiary}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource Accent}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top"
                                        Visibility="{Binding IsBest, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0">
                                    <TextBlock Text="Best match" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnAccent}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource SelectedCand}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="dot" Property="Stroke" Value="{StaticResource Accent}" />
                                <Setter TargetName="pip" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#5A5A5A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,24,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,32,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Drivers" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding ScanCommand}" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="Rescan" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Summary tiles -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,20,10" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource CardRaised}" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource MissingBg}">
                        <TextBlock Text="{Binding MissingCount}" Foreground="#FF99A4" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Missing driver" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Device isn't working" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardRaised}" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource UpdateBg}">
                        <TextBlock Text="{Binding UpdateCount}" Foreground="{StaticResource Accent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Updates available" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Newer, better-matched drivers" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardRaised}" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource OkBg}">
                        <TextBlock Text="{Binding UpToDateCount}" Foreground="{StaticResource OkFg}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Up to date" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Nothing to do" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Banners: first run, errors, test mode -->
        <StackPanel Grid.Row="2" Margin="0,0,32,0">
            <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnLine}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                    Visibility="{Binding Warnings, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Warnings}" Foreground="{StaticResource WarnFg}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource MissingBg}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12"
                    Visibility="{Binding Error, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource MissingFg}" TextWrapping="Wrap" FontFamily="Segoe UI" />
            </Border>
            <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnLine}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                    Visibility="{Binding TestMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="{StaticResource WarnFg}" TextWrapping="Wrap"
                           Text="Test mode is on: installs download drivers and back up the current ones but don't install anything. Turn it off in Settings." />
            </Border>
        </StackPanel>

        <!-- Filter chips -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Chips}" Margin="0,4,32,10" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FilterChip}">
                    <Button Style="{StaticResource Chip}" Command="{Binding PickCommand}" Content="{Binding Label}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Device list + details -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                <StackPanel Margin="0,0,0,20">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceGroup}">
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource DeviceRow}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8" Padding="14,10"
                            Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="18" Foreground="{StaticResource OkFg}" Margin="0,0,12,0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Show"
                                    Command="{Binding Chips[4].PickCommand}" />
                            <TextBlock VerticalAlignment="Center" Foreground="#C8C8C8" Text="{Binding UpToDateText}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Busy overlay over the list -->
            <Border Background="#CC272727" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Grid.ColumnSpan="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
                    <TextBlock Text="{Binding BusyText}" Foreground="White" FontSize="15" Margin="0,16,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Details pane -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,24,20"
                          Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                <Border Style="{StaticResource PanelCard}" DataContext="{Binding Selected}">
                    <StackPanel>
                        <TextBlock Text="{Binding ClassName}" FontSize="12" Foreground="{StaticResource TextTertiary}" />
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,4" />
                        <TextBlock Text="{Binding HardwareId}" Style="{StaticResource MonoSmall}" TextWrapping="Wrap" TextTrimming="None" />

                        <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnLine}" BorderThickness="1" CornerRadius="8"
                                Padding="12,10" Margin="0,14,0,0" Visibility="{Binding Reason, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding Reason}" Foreground="{StaticResource WarnFg}" TextWrapping="Wrap" FontSize="13" />
                        </Border>

                        <Border Background="{StaticResource Inset}" CornerRadius="8" Padding="14,12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Installed now" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="{Binding InstalledLine}" Foreground="#C8C8C8" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Available drivers" FontWeight="SemiBold" Foreground="White" Margin="0,16,0,2" />
                        <TextBlock Text="Ranked the way Windows ranks them: match and signature, then date, then version. Pick one to install it."
                                   Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Candidates}" ItemTemplate="{StaticResource CandidateRow}" />
                        <TextBlock Text="No source has a driver for this device.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Candidates.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Copy hardware ID" Margin="0,0,8,8"
                                    Command="{Binding DataContext.CopyHardwareIdCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource GhostButton}" Content="Search Microsoft catalog" Margin="0,0,8,8"
                                    Command="{Binding DataContext.SearchOnlineCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource GhostButton}" Content="Ignore this device" Margin="0,0,8,8"
                                    Command="{Binding DataContext.IgnoreCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="5" Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="0,12,32,12" Margin="-32,0,0,0">
            <DockPanel Margin="32,0,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}"
                        IsEnabled="{Binding CanInstall}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,8,0" Foreground="{StaticResource OnAccent}" />
                        <TextBlock Text="{Binding InstallLabel}" />
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionSummary}" Foreground="#C8C8C8" VerticalAlignment="Center" Margin="0,0,16,0" />
                <WrapPanel VerticalAlignment="Center">
                    <CheckBox Content="Create a restore point first" IsChecked="{Binding CreateRestorePoint}" Margin="0,0,24,0" />
                    <CheckBox Content="Restart automatically if needed" IsChecked="{Binding RestartWhenNeeded}" Margin="0,0,24,0" />
                    <Button Style="{StaticResource GhostButton}" Content="Select recommended" Command="{Binding SelectAllRecommendedCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="Select none" Command="{Binding SelectNoneCommand}" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
