<UserControl x:Class="DriverForge.Views.ComingSoonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="32,24,32,32" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="White" />
        <Border Style="{StaticResource PanelCard}" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="Not built yet" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="{Binding Body}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="14" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
