<UserControl x:Class="DriverForge.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1000" HorizontalAlignment="Left">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Copy as text" Command="{Binding CopyCommand}" />
                </StackPanel>
                <TextBlock Text="System info" FontSize="28" FontWeight="SemiBold" Foreground="White" />
            </DockPanel>
            <TextBlock Text="What this PC is, for finding drivers by hand or asking for help."
                       Style="{StaticResource Secondary}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,8" />
            <TextBlock Text="{Binding Copied}" Foreground="{StaticResource OkFg}" Margin="0,0,0,8"
                       Visibility="{Binding Copied, Converter={StaticResource NullToVis}}" />

            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12" Visibility="{Binding Status, Converter={StaticResource NullToVis}}">
                <DockPanel>
                    <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="18" Height="18" Margin="0,0,12,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Status}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,8" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Secondary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="White" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,20,0,4">
                <CheckBox DockPanel.Dock="Right" Content="Include drivers that came with Windows" IsChecked="{Binding IncludeWindowsDrivers}"
                          Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                <TextBlock Text="Drivers by install date" FontSize="20" FontWeight="SemiBold" Foreground="White" />
            </DockPanel>
            <TextBlock Text="{Binding DriversNote}" Style="{StaticResource Secondary}" Margin="0,0,0,8" />

            <Border Style="{StaticResource PanelCard}" Padding="20,12">
                <ItemsControl ItemsSource="{Binding Drivers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding When}" Style="{StaticResource Secondary}" />
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Device}" Foreground="White" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Driver}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Inf}" Style="{StaticResource MonoSmall}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
