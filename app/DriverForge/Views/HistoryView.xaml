<UserControl x:Class="DriverForge.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="History &amp; rollback" FontSize="28" FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="Every driver change, newest first. Driver Forge backs up a third-party driver before replacing it, so you can put it back."
                       Style="{StaticResource Secondary}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,16" />

            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12" Visibility="{Binding Status, Converter={StaticResource NullToVis}}">
                <DockPanel>
                    <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="18" Height="18" Margin="0,0,12,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Status}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Nothing installed yet." Style="{StaticResource Secondary}" />
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Roll back" VerticalAlignment="Center"
                                        Command="{Binding DataContext.RollBackCommand, ElementName=Root}" CommandParameter="{Binding}"
                                        IsEnabled="{Binding DataContext.IsBusy, ElementName=Root, Converter={StaticResource InvBool}}"
                                        Visibility="{Binding CanRollBack, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="Roll back this change" />
                                <StackPanel Margin="0,0,16,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Secondary}" Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding Device}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0">
                                        <Run Text="{Binding From, Mode=OneWay}" /><Run Text="  →  " /><Run Text="{Binding To, Mode=OneWay}" Foreground="White" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource OkFg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Failed}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource MissingFg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
