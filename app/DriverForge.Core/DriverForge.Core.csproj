<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DriverForge.Core</RootNamespace>
    <Authors>Hillyard Tech</Authors>
    <Copyright>Copyright (c) 2026 Hillyard Tech</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <!-- winget, in-process (docs/APPS.md §3). ComInterop is only the C#
         projection here: FactoryLinkage none skips its out-of-process factory
         DLL, so activation can only resolve to the in-process engine that
         the app manifest names. -->
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.29.380" />
    <!-- Only the native engine DLLs; its lib/ .winmd has no TFM (NU1701). -->
    <PackageReference Include="Microsoft.WindowsPackageManager.InProcCom" Version="1.29.380" ExcludeAssets="compile;runtime" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DriverForge.Tests" />
  </ItemGroup>

</Project>
