<?xml version="1.0" encoding="utf-8"?>
<!-- the build box's user-level NuGet.Config lists no sources; name nuget.org here
     instead of changing that machine's global config. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
